# Google Gemini API key for the site chat assistant (app/api/chat/route.ts).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: override the Gemini model used by the chat assistant.
# GEMINI_MODEL=gemini-3.6-flash

# MongoDB connection used by /app/api/leads and the /admin dashboard.
MONGODB_URI=
MONGODB_DB=nexmentor

# Admin dashboard auth (protects /admin/dashboard).
# ADMIN_PASSWORD_HASH is a "salt:hash" string — never store the plaintext password.
# Generate one with:
#   npx tsx -e "import { hashPassword } from './src/lib/auth'; console.log(hashPassword('your-new-password'))"
ADMIN_PASSWORD_HASH=

# Secret used to sign the admin session cookie. Keep this private.
ADMIN_SESSION_SECRET=
